    "@prisma/adapter-pg": "^7.9.1",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.9.1",
    "dotenv": "^17.0.0",
    "vitest": "^4.1.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.10",
    "typescript": "^7.0.2"
  }
