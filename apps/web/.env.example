# Base URL of `apps/api`, without a trailing slash. Read on the client (RF-03 requires the
# screen itself, not a server route handler, to trigger the request), so it must be prefixed
# with NEXT_PUBLIC_ to be inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stub `x-user-id` sent with every request to `apps/api` (spec-FEAT-003b Block 5), substituting
# the real authentication ticket this project does not have yet. Defaults to the fixed test user
# apps/api/prisma/seed.ts creates on seed, so the flow works in dev without extra configuration.
NEXT_PUBLIC_STUB_USER_ID=00000000-0000-4000-8000-000000000001
